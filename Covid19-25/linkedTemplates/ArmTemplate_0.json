{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Covid19-25"
		},
		"Source_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'Source'"
		},
		"sink_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sink'"
		},
		"sink_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "covid19.postgres.database.azure.com"
		},
		"sink_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Covid19"
		},
		"sink_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "Covid19"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Source')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('Source_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sink')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzurePostgreSql",
				"version": "2.0",
				"typeProperties": {
					"server": "[parameters('sink_properties_typeProperties_server')]",
					"port": "5432",
					"database": "[parameters('sink_properties_typeProperties_database')]",
					"sslMode": 3,
					"username": "[parameters('sink_properties_typeProperties_username')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('sink_password')]"
					},
					"authenticationType": "Basic"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Covid_data')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sink",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzurePostgreSqlTable",
				"schema": [
					{
						"name": "state",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "county",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "age_group",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "gender",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "date",
						"type": "date",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "cases",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "deaths",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "recovered",
						"type": "integer",
						"precision": 0,
						"scale": 0
					}
				],
				"typeProperties": {
					"schema": "public",
					"table": "covid_cases_de"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/sink')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Covid_vacines')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Source",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "covid_de_vaccines.csv",
						"container": "covid19csv"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "date",
						"type": "String"
					},
					{
						"name": "doses",
						"type": "String"
					},
					{
						"name": "doses_first",
						"type": "String"
					},
					{
						"name": "doses_second",
						"type": "String"
					},
					{
						"name": "pfizer_cumul",
						"type": "String"
					},
					{
						"name": "moderna_cumul",
						"type": "String"
					},
					{
						"name": "astrazeneca_cumul",
						"type": "String"
					},
					{
						"name": "persons_first_cumul",
						"type": "String"
					},
					{
						"name": "persons_full_cumul",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Source')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Coviddata')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Source",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "demographics_de.csv",
						"container": "covid19csv"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "state",
						"type": "String"
					},
					{
						"name": "gender",
						"type": "String"
					},
					{
						"name": "age_group",
						"type": "String"
					},
					{
						"name": "population",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Source')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Demographic')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sink",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzurePostgreSqlTable",
				"schema": [
					{
						"name": "state",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "gender",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "age_group",
						"type": "character varying",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "population",
						"type": "integer",
						"precision": 0,
						"scale": 0
					}
				],
				"typeProperties": {
					"schema": "public",
					"table": "demographics_de"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/sink')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Vacines')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sink",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzurePostgreSqlTable",
				"schema": [
					{
						"name": "date",
						"type": "date",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "doses",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "doses_first",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "doses_second",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "pfizer_cumul",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "moderna_cumul",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "astrazeneca_cumul",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "persons_first_cumul",
						"type": "integer",
						"precision": 0,
						"scale": 0
					},
					{
						"name": "persons_full_cumul",
						"type": "integer",
						"precision": 0,
						"scale": 0
					}
				],
				"typeProperties": {
					"schema": "public",
					"table": "covid_vaccines_de"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/sink')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/demographics_de')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Source",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "demographics_de.csv",
						"container": "covid19csv"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "state",
						"type": "String"
					},
					{
						"name": "gender",
						"type": "String"
					},
					{
						"name": "age_group",
						"type": "String"
					},
					{
						"name": "population",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Source')]"
			]
		}
	]
}