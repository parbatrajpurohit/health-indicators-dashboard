				"annotations": [],
				"type": "AzurePostgreSql",
				"version": "2.0",
				"typeProperties": {
					"server": "[parameters('sink_properties_typeProperties_server')]",
					"port": "5432",
					"database": "[parameters('sink_properties_typeProperties_database')]",
					"sslMode": 3,
					"username": "[parameters('sink_properties_typeProperties_username')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('sink_password')]"
					},
					"authenticationType": "Basic"
				}
			},
			"dependsOn": []
		},
