{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Covid19-25"
		},
		"Source_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'Source'"
		},
		"sink_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sink'"
		},
		"sink_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "covid19.postgres.database.azure.com"
		},
		"sink_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Covid19"
		},
		"sink_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "Covid19"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "Covid19-25_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Source_connectionString": {
						"value": "[parameters('Source_connectionString')]"
					},
					"sink_password": {
						"value": "[parameters('sink_password')]"
					},
					"sink_properties_typeProperties_server": {
						"value": "[parameters('sink_properties_typeProperties_server')]"
					},
					"sink_properties_typeProperties_database": {
						"value": "[parameters('sink_properties_typeProperties_database')]"
					},
					"sink_properties_typeProperties_username": {
						"value": "[parameters('sink_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}